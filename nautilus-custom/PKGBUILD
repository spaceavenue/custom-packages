pkgname=nautilus-custom
pkgver=50.3.1
pkgrel=1
pkgdesc="Default file manager for GNOME w/o gvfs"
arch=('x86_64')
url="https://apps.gnome.org/Nautilus/"
license=('GPL-3.0-or-later')
groups=('gnome')

depends=('cairo' 'dconf' 'gdk-pixbuf2' 'gexiv2' 'glib2' 'glibc' 'glycin' 'glycin-gtk4'
         'gnome-autoar' 'gnome-desktop-4' 'graphene' 'gst-plugins-base-libs' 'gstreamer'
         'gtk4' 'hicolor-icon-theme' 'icu' 'libadwaita' 'libcloudproviders' 'libgcc'
         'libnautilus-extension' 'libportal' 'libportal-gtk4' 'libx11' 'localsearch'
         'pango' 'tinysparql' 'wayland' 'xdg-user-dirs-gtk')
optdepends=('gvfs: trash, MTP, and network (smb/sftp/afp/...) locations in the sidebar')

provides=("nautilus=$pkgver")
conflicts=('nautilus')

source=("https://archive.archlinux.org/packages/n/nautilus/nautilus-${pkgver}-${pkgrel}-${arch}.pkg.tar.zst")
sha256sums=('14f5b620c1312f2b7135e2a379a572d996e8c5e8411fe988ebc714e3b7c6f7a1')

options=(!strip !debug)

package() {
  cd "$srcdir"
  cp -a usr "${pkgdir}"/
}
