pkgname=zed-custom
pkgver=1.25.2
pkgrel=1
pkgdesc="A high-performance, multiplayer code editor from the creators of Atom and Tree-sitter (repackaged, nodejs/npm made optional)"
arch=('x86_64')
url="https://zed.dev"
license=('GPL-3.0-or-later' 'AGPL-3.0-or-later' 'Apache-2.0')

# keep pkgver/pkgrel in lockstep with extra/zed - this just relays the
# official build with nodejs/npm demoted to optdepends
depends=('alsa-lib' 'curl' 'fontconfig' 'git' 'glib2' 'glibc' 'libgcc' 'libstdc++'
         'libxcb' 'libx11' 'libxkbcommon' 'libxkbcommon-x11' 'netcat' 'sqlite'
         'vulkan-driver' 'vulkan-icd-loader' 'vulkan-tools' 'wayland' 'zstd')
optdepends=('nodejs: JavaScript/TypeScript/JSON/ESLint/Prettier language servers, extensions'
            'npm: installing extension-provided language servers')

provides=("zed=$pkgver")
conflicts=('zed')

source=("https://archive.archlinux.org/packages/z/zed/zed-${pkgver}-${pkgrel}-${arch}.pkg.tar.zst")
sha256sums=('60606ae7a0ce8740710e58dd70bd3b442f28b228a7ed95c45c8ff5ed5d05de76')

options=(!strip !debug)

package() {
  cd "$srcdir"
  cp -a usr "${pkgdir}"/
}
