pkgname=swaylock-time
_pkgname=swaylock
pkgver=1.8.6
pkgrel=1
pkgdesc='Screen locker for Wayland (with clock support)'
arch=('x86_64')
url="https://github.com/swaywm/swaylock"
license=("MIT")
depends=(
"cairo"
"gdk-pixbuf2"
"glib2"
"glibc"
"pam"
"wayland"
"libxkbcommon"
)
makedepends=(
"git"
"meson"
"scdoc"
"wayland-protocols"
)
provides=("${_pkgname}")
conflicts=("${_pkgname}")
source=("${_pkgname}::git+${url}.git" "time.patch")
b2sums=('SKIP' 'SKIP')

build() {
  pushd "${_pkgname}"
  git apply ../"time.patch"
  popd
  arch-meson "${_pkgname}" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  install -Dm644 "${_pkgname}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${_pkgname}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
