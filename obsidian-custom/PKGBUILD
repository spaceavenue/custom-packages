pkgname=obsidian-custom
_pkgname=obsidian
pkgver=1.13.7
pkgrel=1
pkgdesc="A powerful knowledge base that works on top of a local folder of plain text Markdown files"
arch=('x86_64')
url="https://obsidian.md"
license=('LicenseRef-Obsidian')
depends=('fontconfig' 'bash' 'zlib' 'hicolor-icon-theme' 'electron')
install=obsidian.install
provides=($_pkgname)
conflicts=($_pkgname)
source=(
  "${_pkgname}.tar.zst::https://archlinux.org/packages/extra/x86_64/obsidian/download"
  "${_pkgname}.sh"
)
sha256sums=('SKIP'
            '65111c9b78df85da9ff2666c3fdc1aec8cef4adb3489394622d058a878cb2e92')
b2sums=('SKIP'
        '48e7be6c240fcde3ac87464e554113d2d2d6a09f0e90c4dc7bc008b7011b30adec9018c6ed0a0e3c0192ccb864fc7a6776a9e4b8fb5307ae78ad9b54df95efa7')

package() {

  # everything
  cp -ar ./usr "$pkgdir"
  
  # Launcher
  install -Dm755 "${_pkgname}.sh" "${pkgdir}/usr/bin/${_pkgname}"
}

