pkgname=clang-gccless
pkgver=23.1.3
pkgrel=1
pkgdesc="Clang binary repackaged without GCC and pre-configured for LLVM+Mold"
arch=('x86_64')
url="https://clang.llvm.org/"
license=('Apache-2.0 WITH LLVM-exception')

depends=('llvm-libs' 'compiler-rt' 'libgcc' 'libxml2')

provides=("clang=$pkgver" "clang-analyzer=$pkgver" "clang-tools-extra=$pkgver" "cc")
conflicts=('clang' 'clang-analyzer' 'clang-tools-extra')
replaces=('clang-analyzer' 'clang-tools-extra')

source=("https://archive.archlinux.org/packages/c/clang/clang-${pkgver}-${pkgrel}-${arch}.pkg.tar.zst")
sha256sums=('fd91459a3bca6663c13b0ace5589b7cc0beb91b4375051d36df1f86bc018aa22')

options=(!strip)

package() {
  cd "$srcdir"

  cp -a usr "${pkgdir}"/
  ln -sf clang "${pkgdir}/usr/bin/cc"
  mkdir -p "${pkgdir}/etc/clang"
  
  cat << EOF > "${pkgdir}"/etc/clang/clang.cfg
--rtlib=compiler-rt
--unwindlib=libgcc
-fuse-ld=mold
EOF

  ln -s clang.cfg "${pkgdir}"/etc/clang/clang++.cfg
  ln -s clang.cfg "${pkgdir}"/etc/clang/cc.cfg

  ln -sf /etc/clang/clang.cfg   "${pkgdir}"/usr/bin/clang.cfg
  ln -sf /etc/clang/clang++.cfg "${pkgdir}"/usr/bin/clang++.cfg
  ln -sf /etc/clang/cc.cfg      "${pkgdir}"/usr/bin/cc.cfg
  ln -sf /etc/clang/clang.cfg   "${pkgdir}"/usr/bin/x86_64-pc-linux-gnu.cfg 

  local clang_major="${pkgver%%.*}"
  local rt_dir="${pkgdir}/usr/lib/clang/${clang_major}/lib/x86_64-pc-linux-gnu"
  mkdir -p "$rt_dir"
  
  ln -s clang_rt.crtbegin.o "${rt_dir}/crtbegin.o"
  ln -s clang_rt.crtbegin.o "${rt_dir}/crtbeginS.o"
  ln -s clang_rt.crtbegin.o "${rt_dir}/crtbeginT.o"
  ln -s clang_rt.crtend.o   "${rt_dir}/crtend.o"
  ln -s clang_rt.crtend.o   "${rt_dir}/crtendS.o"

  ln -s /usr/lib/libgcc_s.so.1 "${rt_dir}/libgcc_s.so"
}
