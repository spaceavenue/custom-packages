pkgname=rustbg
pkgver=r4.6a5f7f2
pkgrel=1
pkgdesc="Tiny, minimal wallpaper daemon for wayland."
arch=('x86_64' 'aarch64')
url=https://codeberg.org/spaceavenue/$pkgname
license=()
makedepends=('cargo')
# depends=('')

source=("${pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  git switch dump-bgra --quiet
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd ${pkgname}
  git switch dump-bgra
  cargo +nightly build --release
  
}

package() {
  cd ${pkgname}
  install -Dm 755 target/x86_64-unknown-linux-musl/release/${pkgname} "${pkgdir}/usr/bin/${pkgname}"
}
