pkgname=swaylock-time
pkgver=1.8.6
pkgrel=1
pkgdesc='Screen locker for Wayland (with clock support)'
arch=('x86_64')
url="https://github.com/spaceavenue/swaylock"
license=("MIT")
depends=(
"cairo"
"gdk-pixbuf2"
"glib2"
"glibc"
"pam"
"wayland"
"libxkbcommon"
)
makedepends=(
"git"
"meson"
"scdoc"
"wayland-protocols"
)
provides=("${pkgname%-time}")
conflicts=("${pkgname%-time}")
source=("${pkgname}::git+${url}.git")
b2sums=('SKIP')

build() {
  arch-meson "$pkgname" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  install -Dm644 "${pkgname}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${pkgname}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
