pkgname=helix-custom
_pkgname=helix
pkgver=20260929.023219
pkgrel=1
pkgdesc="A text editor written in rust"
url="https://helix-editor.com"
license=("MPL-2.0")
_git="https://github.com/helix-editor/${_pkgname}"
arch=(x86_64)
makedepends=('cargo')
depends=()
provides=('hx')
conflicts=('helix')
options=(!lto)

# plain master-branch snapshot, no git history/clone involved at all.
# pkgver is the tracked commit's date (YYYYMMDD.HHMMSS) - kept in sync by
# pkg-build via nvchecker ([helix-custom]: source=github, date-based
# tracking), same mechanism as the archpkg-sourced packages. No pkgver()
# here on purpose: there's nothing local to derive it from once this is
# just a tarball, and pkg-build's sed + updpkgsums already handle it.
source=("${_pkgname}.tar.gz::${_git}/archive/refs/heads/master.tar.gz")
sha256sums=('26142d96d2d29cda92e5d7d6996aee2434214d34a27d1431115e7d6fcc1fa810')

_bin="hx"
_lib_path="/usr/lib/${_pkgname}"
_rt_path="${_lib_path}/runtime"

_grammars=(
    bash
    c
    cmake
    comment
    cpp
    css
    diff
    dockerfile
    fish
    git-config
    git-rebase
    gitattributes
    gitcommit
    gitignore
    graphql
    html
    ini
    javascript
    json
    json5
    lua
    make
    markdown
    markdown_inline
    python
    regex
    requirements
    ron
    rust
    scss
    toml
    tsx
    typescript
    typst
    yaml
    zig
)

prepare() {
    cat > "$_bin" << EOF
#!/usr/bin/env sh
HELIX_RUNTIME=${_rt_path} exec ${_lib_path}/${_bin} "\$@"
EOF
    chmod +x "$_bin"

    cd "${_pkgname}-master"
    rm rust-toolchain.toml

    # Restrict tree-sitter grammars to only the desired languages
    local _grammar_list
    _grammar_list=$(printf '"%s", ' "${_grammars[@]}")
    sed -i "s|^use-grammars = .*|use-grammars = { only = [ ${_grammar_list%, } ] }|" languages.toml

    export CARGO_TARGET_DIR=target
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "${_pkgname}-master"
    export CARGO_TARGET_DIR=target
    export RUSTFLAGS="-C target-cpu=native"
    export CC=clang
    export CXX=clang++
    cargo +nightly build --locked --profile opt
}

# check() {
    # cd "${_pkgname}-master"
    # export CARGO_TARGET_DIR=target
    # cargo +nightly test --workspace --locked
    # export RUSTFLAGS="${RUSTFLAGS} --cfg tokio_unstable"
    # cargo integration-test --locked
# }

package() {
    cd "${_pkgname}-master"
    mkdir -p "${pkgdir}${_lib_path}"
    rm -rf  "runtime/grammars/sources"
    cp -r "runtime" "${pkgdir}${_lib_path}"
    install -Dm 0755 "target/opt/${_bin}" "${pkgdir}${_lib_path}/${_bin}"
    install -Dm 0644 "LICENSE" "${pkgdir}/usr/share/licenses/${_pkgname}/LICENSE"
    install -Dm 0777 "${srcdir}/${_bin}" "${pkgdir}/usr/bin/${_bin}"
    install -Dm 0644 "contrib/Helix.desktop" "${pkgdir}/usr/share/applications/Helix.desktop"
    install -Dm 0644 "contrib/Helix.appdata.xml" "${pkgdir}/usr/share/appdata/Helix.appdata.xml"
    install -Dm 0644 "contrib/helix.png" "${pkgdir}/usr/share/icons/helix.png"
    install -Dm 0644 "contrib/completion/hx.zsh" "${pkgdir}/usr/share/zsh/site-functions/_hx"
    install -Dm 0644 "contrib/completion/hx.bash" "${pkgdir}/usr/share/bash-completion/completions/hx.bash"
    install -Dm 0644 "contrib/completion/hx.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/hx.fish"
}
