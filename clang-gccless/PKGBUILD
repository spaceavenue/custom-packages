pkgname=clang-gccless
pkgver=23.1.1
pkgrel=1
pkgdesc="Clang binary repackaged without GCC and pre-configured for LLVM+Mold"
arch=('x86_64')
url="https://clang.llvm.org/"
license=('Apache-2.0 WITH LLVM-exception')

depends=('llvm-libs' 'compiler-rt' 'libgcc' 'libstdc++' 'libc++' 'libunwind' 'libxml2')

provides=("clang=$pkgver" "clang-analyzer=$pkgver" "clang-tools-extra=$pkgver")
conflicts=('clang' 'clang-analyzer' 'clang-tools-extra')
replaces=('clang-analyzer' 'clang-tools-extra')

source=("https://archive.archlinux.org/packages/c/clang/clang-${pkgver}-${pkgrel}-${arch}.pkg.tar.zst")
sha256sums=('3f9c1b50705e8f9f23dc27a52be25e341288d93bf975b745462afa7e31cbc020')

options=(!strip)

package() {
  cd "$srcdir"

  cp -a usr "${pkgdir}"/

  mkdir -p "${pkgdir}"/etc/clang
  
  # unwindlib=libunwind fails to link any throwing C++ under mold
  # (undefined __gxx_personality_v0 / _Unwind_Resume - verified 2026-09-11);
  # libgcc_s is already a mandatory system lib regardless of this choice.
  cat <<EOF > "${pkgdir}"/etc/clang/clang.cfg
--rtlib=compiler-rt
--unwindlib=libgcc
-stdlib=libc++
-fuse-ld=mold
EOF

  ln -s clang.cfg "${pkgdir}"/etc/clang/clang++.cfg
  ln -s clang.cfg "${pkgdir}"/etc/clang/cc.cfg

  mv "${pkgdir}"/usr/bin/clang "${pkgdir}"/usr/bin/clang-real

  cat <<'EOF' > "${pkgdir}"/usr/bin/clang
#!/bin/sh
TARGET_NAME=$(basename "$0")

exec -a "$TARGET_NAME" /usr/bin/clang-real --config "/etc/clang/${TARGET_NAME}.cfg" "$@"
EOF

  chmod +x "${pkgdir}"/usr/bin/clang

  chmod +x "${pkgdir}"/usr/bin/clang

  rm -f "${pkgdir}"/usr/bin/clang++ "${pkgdir}"/usr/bin/cc
  ln -s clang "${pkgdir}"/usr/bin/clang++
  ln -s clang "${pkgdir}"/usr/bin/cc

  local clang_major="${pkgver%%.*}"
  
  ln -s "clang/${clang_major}/lib/linux/clang_rt.crtbegin-x86_64.o" "$pkgdir/usr/lib/crtbegin.o"
  ln -s "clang/${clang_major}/lib/linux/clang_rt.crtbegin-x86_64.o" "$pkgdir/usr/lib/crtbeginS.o"
  ln -s "clang/${clang_major}/lib/linux/clang_rt.crtbegin-x86_64.o" "$pkgdir/usr/lib/crtbeginT.o"
  ln -s "clang/${clang_major}/lib/linux/clang_rt.crtend-x86_64.o" "$pkgdir/usr/lib/crtend.o"
  ln -s "clang/${clang_major}/lib/linux/clang_rt.crtend-x86_64.o" "$pkgdir/usr/lib/crtendS.o"

  ln -s libgcc_s.so.1 "${pkgdir}"/usr/lib/libgcc_s.so
}
